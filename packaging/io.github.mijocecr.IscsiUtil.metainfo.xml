<component type="desktop-application">
  <id>io.github.mijocecr.IscsiUtil</id>

  <name>iSCSI Util</name>
  <summary>A simple and modern GUI for managing iSCSI</summary>

  <developer id="io.github.mijocecr">
    <name>Miguel Cerrato</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      iSCSI Util is a graphical application to discover, connect and manage
      iSCSI targets and sessions on Linux, including CHAP authentication,
      LUN initialization and persistence across reboots, without editing
      open-iscsi configuration files by hand.
    </p>
  </description>

  <launchable type="desktop-id">io.github.mijocecr.IscsiUtil.desktop</launchable>

  <url type="homepage">https://github.com/mijocecr/iscsi-util</url>
  <url type="bugtracker">https://github.com/mijocecr/iscsi-util/issues</url>

