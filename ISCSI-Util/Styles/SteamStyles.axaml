<Styles xmlns="https://github.com/avaloniaui">

  <!-- GLOBAL BACKGROUND -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource SteamBackground}" />
  </Style>

  <!-- TEXTBLOCK -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SteamText}" />
  </Style>

  <!-- BUTTON (base Steam) -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource SteamCard}" />
    <Setter Property="Foreground" Value="{DynamicResource SteamText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SteamBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource SteamAccentHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource SteamAccentPressed}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- LISTBOX -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource SteamPanel}" />
    <Setter Property="Foreground" Value="{DynamicResource SteamText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SteamBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource SteamCard}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- TABCONTROL -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="{DynamicResource SteamBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SteamBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- TABITEM -->
  <Style Selector="TabItem">
    <Setter Property="Background" Value="{DynamicResource SteamPanel}" />
    <Setter Property="Foreground" Value="{DynamicResource SteamText}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource SteamCard}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- CARD / PANEL ELEVADO STEAM -->
  <Style Selector="Border.SteamCard">
    <Setter Property="Background" Value="{DynamicResource SteamCardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SteamBorderStrong}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10" />
    <!-- Sombra solo si el control la soporta (Border sí la tiene) -->
    <Setter Property="BoxShadow" Value="0 4 12 #80000000" />
  </Style>
  
  
    <!-- ============================================================
       PASSWORD DIALOG — estilo original Steam
  ============================================================ -->

  <!-- Ventana del diálogo -->
  <Style Selector="Window.PasswordDialog">
    <Setter Property="Background" Value="{DynamicResource SteamPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SteamAccent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Width" Value="360" />
    <Setter Property="Height" Value="200" />
  </Style>

  <!-- Título -->
  <Style Selector="TextBlock.PasswordDialogTitle">
    <Setter Property="Foreground" Value="{DynamicResource SteamText}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- Mensaje -->
  <Style Selector="TextBlock.PasswordDialogMessage">
    <Setter Property="Foreground" Value="{DynamicResource SteamText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <!-- Input -->
  <Style Selector="TextBox.PasswordDialogInput">
    <Setter Property="Background" Value="{DynamicResource SteamCard}" />
    <Setter Property="Foreground" Value="{DynamicResource SteamText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SteamAccent}" />
    <Setter Property="BorderThickness" Value="1.4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Botones -->
  <Style Selector="Button.PasswordDialogButton">
    <Setter Property="Background" Value="{DynamicResource SteamAccent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource SteamAccentPressed}" />
    <Setter Property="BorderThickness" Value="1.2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.PasswordDialogButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource SteamAccentHover}" />
  </Style>

  <Style Selector="Button.PasswordDialogButton:pressed">
    <Setter Property="Background" Value="{DynamicResource SteamAccentPressed}" />
  </Style>

  

</Styles>
