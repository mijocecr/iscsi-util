<UserControl
    x:Class="ISCSI_Util.Views.SessionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls">

    <Border Background="{DynamicResource SteamBackground}" Padding="24">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">

            <!-- BÚSQUEDA, RESCAN Y REFRESCAR -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBox x:Name="SearchBox" 
                         Watermark="Search targets by IQN or portal..."
                         Padding="12,8" 
                         Background="{DynamicResource SteamPanel}"
                         BorderBrush="{DynamicResource SteamBorder}" 
                         BorderThickness="1.2"
                         Foreground="{DynamicResource SteamText}" 
                         CornerRadius="8"
                         TextChanged="SearchBox_OnTextChanged" />

                <Button x:Name="RescanButton"
                        Grid.Column="1" 
                        Content="Rescan All"
                        ToolTip.Tip="Rescan every connected target to detect new LUNs or size changes without disconnecting or unmounting."
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource SteamCard}"
                        Foreground="{DynamicResource SteamText}"
                        BorderBrush="{DynamicResource SteamBorder}"
                        BorderThickness="1.2"
                        CornerRadius="8"
                        Padding="14,8"
                        MinWidth="100"
                        IsEnabled="False"
                        Click="RescanButton_OnClick" />

                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        Content="Refresh"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource SteamCard}"
                        Foreground="{DynamicResource SteamText}"
                        BorderBrush="{DynamicResource SteamBorder}"
                        BorderThickness="1.2"
                        CornerRadius="8"
                        Padding="14,8"
                        MinWidth="100"
                        Click="RefreshButton_OnClick" />
            </Grid>

            <!-- CONTENIDO PRINCIPAL (2 Columnas) -->
            <Grid Grid.Row="1" ColumnDefinitions="1*,1.5*" ColumnSpacing="20">

                <!-- COLUMNA IZQUIERDA: Lista de Targets -->
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <TextBlock Text="AVAILABLE TARGETS" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource SteamGreen}" Margin="4,0,0,0" />

                    <Border Grid.Row="1"
                            Background="{DynamicResource SteamPanel}"
                            BorderBrush="{DynamicResource SteamBorder}"
                            BorderThickness="1.2"
                            CornerRadius="12"
                            Padding="10">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SessionsList" 
                                            Spacing="6" 
                                            HorizontalAlignment="Stretch" 
                                            Margin="2,2,6,2" />
                            </ScrollViewer>

                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="8" IsVisible="False">
                                <TextBlock x:Name="EmptyStateTitle" Text="No targets found" FontSize="15"
                                           FontWeight="SemiBold" Foreground="{DynamicResource SteamText}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyStateDescription"
                                           Text="Discover or configure targets from the Targets tab first."
                                           FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Foreground="{DynamicResource SteamText}" Opacity="0.7" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- COLUMNA DERECHA: Panel de Detalles (Contador arriba y Tarjeta abajo) -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6">

                    <!-- Contador e indicador de conexiones arriba (Alineado con AVAILABLE TARGETS) -->
                    <Border Background="{DynamicResource SteamPanel}"
                            BorderBrush="{DynamicResource SteamBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            HorizontalAlignment="Stretch"
                            Margin="4,0,0,0">
                        <TextBlock x:Name="SessionCountText"
                                   Text="Loading..."
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SteamAccent}" />
                    </Border>

                    <!-- Panel de Detalles con Scroll (Tarjeta principal - Oculta por defecto) -->
                    <Border Grid.Row="1"
                            x:Name="DetailsCard" 
                            Background="{DynamicResource SteamPanel}"
                            BorderBrush="{DynamicResource SteamBorder}" 
                            BorderThickness="1.2" 
                            CornerRadius="12" 
                            Padding="16"
                            IsVisible="False">
                    
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12" Margin="0,0,8,0">

                                <!-- Cabecera: IQN arriba, Botón Open (izq) y Estado (der) abajo -->
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                    
                                    <!-- Fila 0: IQN completo arriba -->
                                    <TextBlock x:Name="SessionTitle" Text="Select a target" FontSize="16"
                                               FontWeight="Bold" Foreground="{DynamicResource SteamBlue}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Fila 1: Botón Open a la izquierda y Estado a la derecha -->
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                        <!-- Botón Open rápido (Izquierda) -->
                                        <Button x:Name="BtnOpenInline" Content="Open" 
                                                Background="{DynamicResource SteamCard}"
                                                Foreground="{DynamicResource SteamText}"
                                                BorderBrush="{DynamicResource SteamBorder}"
                                                BorderThickness="1.2"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                IsVisible="False" 
                                                Click="OnOpenInline" />

                                        <!-- Texto de Estado (MOUNTED / CONNECTED / SAVED) a la derecha -->
                                        <TextBlock x:Name="SessionSubtitle"
                                                   Grid.Column="1"
                                                   Text="Detailed storage metrics..."
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <shapes:Rectangle Height="1.2" Fill="{DynamicResource SteamBorder}" Opacity="0.6" />

                                <!-- Contenedor donde se insertan los detalles desde C# -->
                                <StackPanel x:Name="DetailsPanel" Spacing="8" />

                                <!-- Resultado del último reescaneo -->
                                <TextBlock x:Name="RescanStatusText"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           IsVisible="False"
                                           Foreground="{DynamicResource SteamGreen}" />

                                <!-- Botones de acción inferiores -->
                                <StackPanel Orientation="Vertical"
                                            Spacing="8"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0">

                                    <StackPanel Orientation="Horizontal" Spacing="8">

                                        <!-- Botón Principal Inteligente (Connect / Mount) -->
                                        <Button x:Name="BtnAction" Content="Connect"
                                                Background="{DynamicResource SteamAccent}"
                                                Foreground="{DynamicResource SteamText}"
                                                BorderBrush="{DynamicResource SteamAccent}"
                                                HorizontalAlignment="Left"
                                                BorderThickness="1.2"
                                                CornerRadius="8"
                                                Padding="14,6"
                                                FontWeight="Bold"
                                                Click="OnPrimaryAction" />

                                        <Button x:Name="BtnUnmount" Content="Unmount"
                                                Background="{DynamicResource SteamCard}"
                                                Foreground="{DynamicResource SteamText}"
                                                BorderBrush="{DynamicResource SteamBorder}"
                                                BorderThickness="1.2"
                                                CornerRadius="8"
                                                Padding="12,6"
                                                IsVisible="False" Click="OnUnmount" />

                                        <Button x:Name="BtnDisconnect" Content="Disconnect"
                                                Background="{DynamicResource SteamPanel}"
                                                Foreground="#FF8A80"
                                                BorderBrush="#E53935"
                                                BorderThickness="1.2"
                                                CornerRadius="8"
                                                Padding="12,6"
                                                IsVisible="False" Click="OnDisconnect" />
                                    </StackPanel>

                                    <!-- Rescan ocupa el ancho de los dos botones superiores -->
                                    <Button x:Name="BtnRescan" Content="Rescan"
                                            ToolTip.Tip="Rescan this target to detect new LUNs or size changes without unmounting. Mounted ext2/3/4, XFS and Btrfs volumes are expanded online."
                                            Background="{DynamicResource SteamCard}"
                                            Foreground="{DynamicResource SteamText}"
                                            BorderBrush="{DynamicResource SteamBorder}"
                                            BorderThickness="1.2"
                                            CornerRadius="8"
                                            Padding="12,6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            IsVisible="False" Click="OnRescan" />
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                </Grid>

            </Grid>

        </Grid>
    </Border>
</UserControl>