<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ISCSI_Util.Views.ChapDialog"
        Width="320"
        Height="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Configure CHAP"
        Background="{DynamicResource SteamBackground}"
        BorderBrush="{DynamicResource SteamBorderStrong}"
        BorderThickness="1.4">

    <StackPanel Margin="12 0 12 0" Spacing="5">

        <TextBlock Text="CHAP Authentication"
                   Margin="0 20 0 20"
                   FontSize="15"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SteamText}"/>

        <!-- GRID ULTRA COMPACTO -->
        <Grid ColumnDefinitions="100, *"
              RowDefinitions="Auto,Auto"
              RowSpacing="2">

            <!-- Username -->
            <TextBlock Text="Username:"
                       Foreground="{DynamicResource SteamBlue}"
                       VerticalAlignment="Center"
                       
                       Grid.Row="0" Grid.Column="0"/>

            <TextBox x:Name="UserBox"
                     Classes="SteamTextBox"
                     Height="20"
                     
                     Watermark="CHAP username"
                     Grid.Row="0" Grid.Column="1"/>

            <!-- Password -->
            <TextBlock Text="Password:"
                       Foreground="{DynamicResource SteamBlue}"
                       VerticalAlignment="Center"
                       Grid.Row="1" Grid.Column="0"/>

            <TextBox x:Name="PassBox"
                     Classes="SteamTextBox"
                     Height="20"
                     PasswordChar="*"
                     Watermark="CHAP password"
                     Grid.Row="1" Grid.Column="1"/>

        </Grid>

        <!-- BOTONES ULTRA COMPACTOS -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="6"
                    Margin="0,4,0,0">

            <Button x:Name="ApplyBtn"
                    Content="Apply"
                    HorizontalContentAlignment="Center"
                    Width="70"
                    Height="30"
                    Classes="SteamButton"/>

            <Button x:Name="CancelBtn"
                    Content="Cancel"
                    HorizontalContentAlignment="Center"
                    Width="70"
                    Height="30"
                    Classes="SteamButton"/>
        </StackPanel>

    </StackPanel>
</Window>
