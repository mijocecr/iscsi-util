<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ISCSI_Util.Views.ChapDialog"
        Width="380"
        Height="260"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Configure CHAP">

    <StackPanel Margin="20" Spacing="14">

        <TextBlock Text="CHAP Authentication"
                   FontSize="20"
                   FontWeight="Bold"/>

        <TextBlock Text="Username:"/>
        <TextBox x:Name="UserBox"
                 Width="220"
                 Watermark="CHAP username"/>

        <TextBlock Text="Password:"/>
        <TextBox x:Name="PassBox"
                 Width="220"
                 Watermark="CHAP password"
                 PasswordChar="●"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

            <Button x:Name="ApplyBtn"
                    Content="Apply"
                    Width="100"/>

            <Button x:Name="CancelBtn"
                    Content="Cancel"
                    Width="100"/>
        </StackPanel>

    </StackPanel>
</Window>