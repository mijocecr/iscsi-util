<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ISCSI_Util.Views.LogsView">

    <DockPanel Margin="10 20 10 10">

        <!-- Barra superior -->
        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Top"
                    Spacing="8">

            <Button x:Name="BtnRefresh"
                    Content="Refresh"
                    HorizontalContentAlignment="Center"
                    Width="90"
                    Margin="0 10"
                    Classes="accent"/>

            <Button x:Name="BtnCopy"
                    Content="Open File"
                    HorizontalContentAlignment="Center"
                    Width="100"
                    Margin="0 10"/>
        </StackPanel>

        <!-- Área de logs con Border y ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#111"
                    BorderBrush="#3A7BFF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    MinHeight="280">
                <TextBlock x:Name="LogText"
                           FontFamily="Consolas, Monospace"
                           FontSize="11"
                           Foreground="#DDD"
                           TextWrapping="Wrap"/>
            </Border>
        </ScrollViewer>

    </DockPanel>

</UserControl>