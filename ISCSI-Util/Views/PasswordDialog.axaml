<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ISCSI_Util.Views.PasswordDialog"
        Width="350" Height="160"
        Title="Administrator permissions"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False">

    <Border Padding="15"
            CornerRadius="8">

        <StackPanel Spacing="10">

            <TextBlock Text="Enter the administrator password to manage iSCSI:"
                       TextWrapping="Wrap"/>

            <TextBox x:Name="PwdBox"
                     KeyDown="OnPasswordKeyDown"
                     PasswordChar="*"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">

                <Button Content="Cancel"
                        HorizontalContentAlignment="Center"
                        Width="90"
                        Click="OnCancel"/>

                <Button Content="OK"
                        HorizontalContentAlignment="Center"
                        Width="90"
                        Click="OnAccept"/>

            </StackPanel>

        </StackPanel>

    </Border>
</Window>