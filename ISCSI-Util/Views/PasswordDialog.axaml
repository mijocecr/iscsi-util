<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ISCSI_Util.Views.PasswordDialog"
        Width="380"
        Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        SystemDecorations="None"
        Background="#1A1A1A"
        TransparencyLevelHint="AcrylicBlur"
        Padding="0">

    <!-- CONTENEDOR PRINCIPAL -->
    <Border Background="#1A1A1A"
            BorderBrush="#3A7BFF"
            BorderThickness="2"
            CornerRadius="10"
            Padding="18"
            Margin="6">

        <StackPanel Spacing="14">

            <!-- TÍTULO -->
            <TextBlock Text="Administrator permissions required"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#E0E0E0"
                       HorizontalAlignment="Center"/>

            <!-- TEXTO -->
            <TextBlock Text="Enter the administrator password to manage iSCSI:"
                       TextWrapping="Wrap"
                       Foreground="#C0C0C0"
                       FontSize="14"/>

            <!-- PASSWORD BOX -->
            <TextBox x:Name="PwdBox"
                     PasswordChar="*"
                     KeyDown="OnPasswordKeyDown"
                     Background="#2A2A2A"
                     BorderBrush="#3A7BFF"
                     Foreground="White"
                     CornerRadius="6"
                     Height="32"/>

            <!-- BOTONES -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        
                        Spacing="10">

                <Button Content="Cancel"
                        Width="90"
                        HorizontalContentAlignment="Center"
                        Classes="SteamButton"
                        Click="OnCancel"/>

                <Button Content="OK"
                        Width="90"
                        HorizontalContentAlignment="Center"
                        Classes="SteamButton"
                        Click="OnAccept"/>

            </StackPanel>

        </StackPanel>

    </Border>
</Window>
