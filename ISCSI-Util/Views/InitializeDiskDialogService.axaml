<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ISCSI_Util.Views.InitializeDiskDialog"
        Width="340"
        Height="170"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Initialize Disk"
        Background="{DynamicResource SteamBackground}"
        BorderBrush="{DynamicResource SteamBorderStrong}"
        BorderThickness="1.4">

    <StackPanel Margin="10" Spacing="6">

        <TextBlock Text="Initialize iSCSI Disk"
                   FontSize="15"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SteamText}"/>

        <!-- GRID ULTRA COMPACTO -->
        <Grid ColumnDefinitions="100, *"
              RowDefinitions="Auto,Auto"
              RowSpacing="6">

            <!-- Label -->
            <TextBlock Text="Label:"
                       Foreground="{DynamicResource SteamBlue}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Grid.Row="0" Grid.Column="0"/>

            <TextBox x:Name="LabelBox"
                     Classes="SteamTextBox"
                     Height="24"
                     Watermark="Volume label"
                     Grid.Row="0" Grid.Column="1"/>

            <!-- Filesystem -->
            <TextBlock Text="Filesystem:"
                       Foreground="{DynamicResource SteamBlue}"
                       VerticalAlignment="Center"
                       Grid.Row="1" Grid.Column="0"/>

            <ComboBox x:Name="FsCombo"
                      Classes="SteamTextBox"
                      Height="24"
                      Width="220"
                      PlaceholderText="Select a filesystem"
                      Grid.Row="1" Grid.Column="1">

                <!-- ORDEN REALISTA Y COMPLETO -->
                <ComboBoxItem Content="ext4"/>
                <ComboBoxItem Content="xfs"/>
                <ComboBoxItem Content="btrfs"/>
                <ComboBoxItem Content="f2fs"/>
                <ComboBoxItem Content="ntfs"/>
                <ComboBoxItem Content="exfat"/>

            </ComboBox>

        </Grid>

        <!-- BOTONES ULTRA COMPACTOS -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="6"
                    Margin="0,6,0,0">

            <Button x:Name="ApplyBtn"
                    Content="Initialize"
                    HorizontalContentAlignment="Center"
                    Width="75"
                    Height="30"
                    Classes="SteamButton"/>

            <Button x:Name="CancelBtn"
                    Content="Cancel"
                    HorizontalContentAlignment="Center"
                    Width="75"
                    Height="30"
                    Classes="SteamButton"/>
        </StackPanel>

    </StackPanel>
</Window>
