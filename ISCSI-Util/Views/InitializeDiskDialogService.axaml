<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ISCSI_Util.Views.InitializeDiskDialog"
        Width="420"
        Height="330"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Initialize Disk">

    <StackPanel Margin="20" Spacing="14">

        <TextBlock Text="Initialize Disk"
                   FontSize="20"
                   FontWeight="Bold"/>

        <TextBlock x:Name="DeviceInfo"
                   FontSize="14"/>

        <TextBlock Text="Label:"/>
        <TextBox x:Name="LabelBox"
                 Width="200"
                 Watermark="Volume label"/>

        <TextBlock Text="Filesystem:"/>
        <ComboBox x:Name="FsCombo"
                  Width="200"/>

        <TextBlock Text="Warning: This will erase all data on the disk."
                   Foreground="Red"
                   FontSize="13"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

            <Button x:Name="OkBtn"
                    Content="Initialize"
                    Width="110"/>

            <Button x:Name="CancelBtn"
                    Content="Cancel"
                    Width="110"/>
        </StackPanel>

    </StackPanel>
</Window>