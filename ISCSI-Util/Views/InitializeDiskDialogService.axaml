<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ISCSI_Util.Views.InitializeDiskDialog"
        Width="420"
        Height="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Initialize Disk">

    <StackPanel Margin="20" Spacing="14">

        <TextBlock Text="Initialize iSCSI Disk"
                   FontSize="20"
                   FontWeight="Bold"/>

        <TextBlock Text="Label:"/>
        <TextBox x:Name="LabelBox"
                 Width="260"
                 Watermark="Volume label"/>

        <TextBlock Text="Filesystem:"/>
        <ComboBox x:Name="FsCombo"
                  Width="260">
            <ComboBoxItem Content="ext4"/>
            <ComboBoxItem Content="xfs"/>
            <ComboBoxItem Content="btrfs"/>
            <ComboBoxItem Content="f2fs"/>
            <ComboBoxItem Content="ntfs"/>
            <ComboBoxItem Content="exfat"/>
        </ComboBox>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

            <Button x:Name="ApplyBtn"
                    Content="Initialize"
                    Width="120"/>

            <Button x:Name="CancelBtn"
                    Content="Cancel"
                    Width="120"/>
        </StackPanel>

    </StackPanel>
</Window>