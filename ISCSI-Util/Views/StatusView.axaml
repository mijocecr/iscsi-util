<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ISCSI_Util.Views.StatusView">

    <!-- ============================================================
         PALETA STEAM
    ============================================================ -->
    <UserControl.Resources>

        <!-- Fondo tarjeta (Steam oscuro) -->
        <SolidColorBrush x:Key="SteamCardBackground"
                         Color="#1B2838" />

        <!-- Borde Steam -->
        <SolidColorBrush x:Key="SteamBorderStrong"
                         Color="#2A475E"/>

        <!-- Verde OK Steam -->
        <SolidColorBrush x:Key="SteamGreen"
                         Color="#8BC53F"/>

        <!-- Azul Steam -->
        <SolidColorBrush x:Key="SteamBlue"
                         Color="#66C0F4"/>

    </UserControl.Resources>

    <UserControl.Styles>

        <!-- Sombra suave estilo Steam (solo en Border, que sí soporta BoxShadow) -->
        <Style Selector="Border.SteamCard">
            <Setter Property="BoxShadow"
                    Value="0 4 12 #80000000"/>
        </Style>

        <!-- BOTONES STEAM (sin BoxShadow, para evitar AVLN2000) -->
        <Style Selector="Button.SteamButton">
            <Setter Property="Background" Value="#1B2838"/>
            <Setter Property="BorderBrush" Value="#2A475E"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#C7D5E0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.SteamButton:pointerover">
            <Setter Property="Background" Value="#223B54"/>
            <Setter Property="BorderBrush" Value="#66C0F4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.SteamButton:pressed">
            <Setter Property="Background" Value="#0F1A24"/>
            <Setter Property="BorderBrush" Value="#1A9FFF"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Margin="20"
          HorizontalAlignment="Stretch">

        <!-- ============================================================
             SYSTEM SUMMARY
        ============================================================ -->
        <Border x:Name="SummaryBorder"
                Classes="SteamCard"
                Background="{DynamicResource SteamCardBackground}"
                BorderBrush="{DynamicResource SteamGreen}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
                HorizontalAlignment="Stretch">

            <TextBlock x:Name="TxtSummary"
                       Text="SYSTEM STATUS: OK"
                       FontSize="18"
                       
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SteamGreen}"/>
        </Border>


        <!-- ============================================================
             TOP STATUS ROW
        ============================================================ -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="16"
              HorizontalAlignment="Stretch">

            <!-- SERVICE STATUS -->
            <Border Grid.Column="0"
                    Classes="SteamCard"
                    Background="{DynamicResource SteamCardBackground}"
                    BorderBrush="{DynamicResource SteamBorderStrong}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="12">

                <StackPanel>
                    <TextBlock Text="Service Status"
                               FontWeight="Bold"
                               
                               Foreground="{DynamicResource SteamBlue}"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="IconIscsid"
                                 Width="12" Height="12"
                                 Fill="{DynamicResource SteamGreen}"/>
                        <TextBlock x:Name="TxtIscsid"
                                   Text="Running"
                                   Foreground="{DynamicResource SteamGreen}"/>
                    </StackPanel>
                </StackPanel>

            </Border>

            <!-- NETWORK STATUS -->
            <Border Grid.Column="1"
                    Classes="SteamCard"
                    Background="{DynamicResource SteamCardBackground}"
                    BorderBrush="{DynamicResource SteamBorderStrong}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="12">

                <StackPanel>
                    <TextBlock Text="Network Status"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="IconNetwork"
                                 Width="12" Height="12"
                                 Fill="{DynamicResource SteamGreen}"/>
                        <TextBlock x:Name="TxtNetwork"
                                   Text="Connected"
                                   Foreground="{DynamicResource SteamGreen}"/>
                    </StackPanel>
                </StackPanel>

            </Border>

            <!-- DAEMON STATUS -->
            <Border Grid.Column="2"
                    Classes="SteamCard"
                    Background="{DynamicResource SteamCardBackground}"
                    BorderBrush="{DynamicResource SteamBorderStrong}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="12">

                <StackPanel>
                    <TextBlock Text="Daemon Status"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="IconSocket"
                                 Width="12" Height="12"
                                 Fill="{DynamicResource SteamGreen}"/>
                        <TextBlock x:Name="TxtSocket"
                                   Text="Operational"
                                   Foreground="{DynamicResource SteamGreen}"/>
                    </StackPanel>
                </StackPanel>

            </Border>

        </Grid>


        <!-- ============================================================
             SYSTEM INFO FULL-WIDTH (MEJORADO)
        ============================================================ -->
        <Border Grid.Row="2"
                Classes="SteamCard"
                Margin="0,16,0,0"
                BorderBrush="{DynamicResource SteamBorderStrong}"
                BorderThickness="2"
                CornerRadius="10"
                Padding="18"
                HorizontalAlignment="Stretch">

            <!-- Fondo con degradado Steam -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#102A475E" Offset="0"/>
                    <GradientStop Color="#081B2838" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel>

                <!-- Header visual -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="System Information"
                               FontSize="16"
                               TextAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"/>
                    <Rectangle Height="1"
                               Fill="#40FFFFFF"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Grid ColumnDefinitions="140,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="6"
                      HorizontalAlignment="Stretch">

                    <!-- Last Operation -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Last Operation:"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="TxtLastOp"
                               Classes="mono"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SteamGreen}"/>

                    <!-- Uptime -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Uptime:"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="TxtUptime"
                               Classes="mono"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SteamGreen}"/>

                    <!-- Hostname -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Hostname:"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <TextBlock Grid.Row="2" Grid.Column="1"
                               x:Name="TxtHostname"
                               Classes="mono"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SteamGreen}"/>

                    <!-- IP Address -->
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="IP Address:"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <TextBlock Grid.Row="3" Grid.Column="1"
                               x:Name="TxtIpAddress"
                               Classes="mono"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SteamGreen}"/>

                    <!-- Latency -->
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="Latency:"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <TextBlock Grid.Row="4" Grid.Column="1"
                               x:Name="TxtLatency"
                               Classes="mono"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SteamGreen}"/>

                </Grid>
            </StackPanel>
        </Border>


        <!-- ============================================================
             BUTTONS
        ============================================================ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">

            <Button Classes="SteamButton"
                    x:Name="BtnReload"
                    Content="Reload"
                    Width="110"/>

            <Button Classes="SteamButton"
                    x:Name="BtnRestart"
                    Content="Restart Service"
                    Width="130"/>

            <Button Classes="SteamButton"
                    x:Name="BtnRefresh"
                    Content="Refresh"
                    Width="110"/>
        </StackPanel>

    </Grid>
</UserControl>
