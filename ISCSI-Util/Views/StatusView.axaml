<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ISCSI_Util.Views.StatusView">

    <!-- ============================================================
         PALETA STEAM
    ============================================================ -->
    <UserControl.Resources>

        <!-- Fondo tarjeta (Steam oscuro) -->
        <SolidColorBrush x:Key="SteamCardBackground"
                         Color="#1B2838" />

        <!-- Borde Steam -->
        <SolidColorBrush x:Key="SteamBorderStrong"
                         Color="#2A475E"/>

        <!-- Verde OK Steam -->
        <SolidColorBrush x:Key="SteamGreen"
                         Color="#8BC53F"/>

        <!-- Azul Steam -->
        <SolidColorBrush x:Key="SteamBlue"
                         Color="#66C0F4"/>

    </UserControl.Resources>

    <UserControl.Styles>

        <!-- Sombra suave estilo Steam (solo en Border, que sí soporta BoxShadow) -->
        <Style Selector="Border.SteamCard">
            <Setter Property="BoxShadow"
                    Value="0 2 8 #60000000"/>
        </Style>

        <!-- Valores técnicos en monoespaciada -->
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas, Menlo, Monospace"/>
        </Style>

        <!-- BOTONES STEAM (sin BoxShadow, para evitar AVLN2000) -->
        <Style Selector="Button.SteamButton">
            <Setter Property="Background" Value="#1B2838"/>
            <Setter Property="BorderBrush" Value="#2A475E"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#C7D5E0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.SteamButton:pointerover">
            <Setter Property="Background" Value="#223B54"/>
            <Setter Property="BorderBrush" Value="#66C0F4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.SteamButton:pressed">
            <Setter Property="Background" Value="#0F1A24"/>
            <Setter Property="BorderBrush" Value="#1A9FFF"/>
        </Style>

        <!-- Acción disruptiva: reiniciar el servicio. Se distingue del resto
             de acciones de consulta para evitar clics accidentales. -->
        <Style Selector="Button.DangerButton">
            <Setter Property="Background" Value="#3A1518"/>
            <Setter Property="BorderBrush" Value="#D9534F"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="#FF9A95"/>
        </Style>

        <Style Selector="Button.DangerButton:pointerover">
            <Setter Property="Background" Value="#5A1E1E"/>
            <Setter Property="BorderBrush" Value="#FF6B66"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.DangerButton:pressed">
            <Setter Property="Background" Value="#2A0F11"/>
            <Setter Property="BorderBrush" Value="#FF4D47"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

    </UserControl.Styles>

    <!-- La ventana es fija (500x580). Este grid reparte el alto disponible
         en cuatro bandas:
         1) banner de estado, 2) tarjetas de servicio/red/daemon,
         3) información y rendimiento, 4) acciones.
         El ScrollViewer es solo una red de seguridad: con el contenido
         normal no aparece, pero si crece (fuentes grandes, textos largos)
         permite desplazarse en lugar de recortar. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalContentAlignment="Stretch"
                  Background="Transparent">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Margin="14"
          HorizontalAlignment="Stretch">

        <!-- ============================================================
             BANNER DE ESTADO
        ============================================================ -->
        <Border x:Name="SummaryBorder"
                Grid.Row="0"
                Classes="SteamCard"
                Background="#1E4620"
                BorderBrush="{DynamicResource SteamGreen}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch">

            <StackPanel Spacing="1"
                        HorizontalAlignment="Center">

                <TextBlock x:Name="TxtSummary"
                           Text="SYSTEM STATUS: OK"
                           FontSize="16"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SteamGreen}"/>

                <TextBlock x:Name="TxtSummaryDetail"
                           Text="All systems operational"
                           FontSize="11"
                           MaxLines="2"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SteamGreen}"/>

            </StackPanel>
        </Border>


        <!-- ============================================================
             TARJETAS DE ESTADO (SERVICIO / RED / DAEMON)
        ============================================================ -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="10"
              Margin="0,0,0,10"
              HorizontalAlignment="Stretch">

            <!-- SERVICE STATUS -->
            <Border Grid.Column="0"
                    Classes="SteamCard"
                    Background="{DynamicResource SteamCardBackground}"
                    BorderBrush="{DynamicResource SteamBorderStrong}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="10,8">

                <StackPanel Spacing="4">
                    <TextBlock Text="Service"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="IconIscsid"
                                 Width="10" Height="10"
                                 Fill="{DynamicResource SteamGreen}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtIscsid"
                                   Text="Running"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamGreen}"/>
                    </StackPanel>
                </StackPanel>

            </Border>

            <!-- NETWORK STATUS -->
            <Border Grid.Column="1"
                    Classes="SteamCard"
                    Background="{DynamicResource SteamCardBackground}"
                    BorderBrush="{DynamicResource SteamBorderStrong}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="10,8">

                <StackPanel Spacing="4">
                    <TextBlock Text="Network"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="IconNetwork"
                                 Width="10" Height="10"
                                 Fill="{DynamicResource SteamGreen}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtNetwork"
                                   Text="Connected"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamGreen}"/>
                    </StackPanel>
                </StackPanel>

            </Border>

            <!-- DAEMON STATUS -->
            <Border Grid.Column="2"
                    Classes="SteamCard"
                    Background="{DynamicResource SteamCardBackground}"
                    BorderBrush="{DynamicResource SteamBorderStrong}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="10,8">

                <StackPanel Spacing="4">
                    <TextBlock Text="Daemon"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="IconSocket"
                                 Width="10" Height="10"
                                 Fill="{DynamicResource SteamGreen}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSocket"
                                   Text="Operational"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamGreen}"/>
                    </StackPanel>
                </StackPanel>

            </Border>

        </Grid>


        <!-- ============================================================
             INFORMACIÓN DEL SISTEMA + RENDIMIENTO iSCSI
        ============================================================ -->
        <Border Grid.Row="2"
                Classes="SteamCard"
                BorderBrush="{DynamicResource SteamBorderStrong}"
                BorderThickness="1.5"
                CornerRadius="8"
                Padding="12"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">

            <!-- Fondo con degradado Steam -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#102A475E" Offset="0"/>
                    <GradientStop Color="#081B2838" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="6">

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="System Information"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SteamBlue}"/>

                <!-- Datos en dos columnas para aprovechar el ancho -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,*,Auto,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="6"
                      RowSpacing="4"
                      HorizontalAlignment="Stretch">

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Uptime:"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="TxtUptime"
                               Classes="mono"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SteamGreen}"/>

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Hostname:"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <TextBlock Grid.Row="0" Grid.Column="3"
                               x:Name="TxtHostname"
                               Classes="mono"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SteamGreen}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="IP:"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="TxtIpAddress"
                               Classes="mono"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SteamGreen}"/>

                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="Latency:"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <TextBlock Grid.Row="1" Grid.Column="3"
                               x:Name="TxtLatency"
                               Classes="mono"
                               FontSize="12"
                               Text="Reading..."
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SteamGreen}"/>

                </Grid>

                <!-- Última operación -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="6">

                    <TextBlock Text="Last operation:"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <TextBlock Grid.Column="1"
                               x:Name="TxtLastOp"
                               Classes="mono"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SteamGreen}"/>
                </Grid>

                <Rectangle Grid.Row="3"
                           Height="1"
                           Fill="#30FFFFFF"
                           Margin="0,2"/>

                <!-- Rendimiento iSCSI -->
                <Grid Grid.Row="4"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="4">

                    <TextBlock Grid.Row="0"
                               Text="iSCSI Performance"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="6">
                        <TextBlock Text="Sessions / Targets:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SteamBlue}"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="TxtSessions"
                                   Classes="mono"
                                   FontSize="12"
                                   Text="Reading..."
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SteamGreen}"/>
                    </Grid>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="6">
                        <TextBlock Text="Throughput:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SteamBlue}"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="TxtThroughput"
                                   Classes="mono"
                                   FontSize="12"
                                   Text="Reading..."
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SteamGreen}"/>
                    </Grid>

                </Grid>

            </Grid>
        </Border>


        <!-- ============================================================
             ACCIONES: consulta a la izquierda, reinicio a la derecha
        ============================================================ -->
        <Grid Grid.Row="3"
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,10,0,0">

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8">

                <Button Classes="SteamButton"
                        x:Name="BtnReload"
                        Content="Reload"
                        Width="100"/>

                <Button Classes="SteamButton"
                        x:Name="BtnRefresh"
                        Content="Refresh"
                        Width="100"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Classes="SteamButton DangerButton"
                    x:Name="BtnRestart"
                    Content="Restart Service"
                    Width="140"
                    ToolTip.Tip="Restarts iscsid. Active sessions and mounted volumes may be interrupted."/>

        </Grid>

    </Grid>

    </ScrollViewer>
</UserControl>
