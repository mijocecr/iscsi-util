<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ISCSI_Util.Views.IscsiMissingWindow"
        Width="560"
        SizeToContent="Height"
        Title="open-iscsi is not installed"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SteamBackground}"
        Foreground="{DynamicResource SteamText}">

    <ScrollViewer Background="{DynamicResource SteamBackground}"
                  VerticalScrollBarVisibility="Auto">
        <Border Margin="12"
                Padding="18"
                Background="{DynamicResource SteamPanel}"
                BorderBrush="{DynamicResource SteamBorderStrong}"
                BorderThickness="1"
                CornerRadius="10">

            <StackPanel Spacing="14">

                <TextBlock Text="open-iscsi is not installed"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SteamText}"/>

                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource SteamText}"
                           Text="iSCSI-Util manages iSCSI targets, sessions and LUNs, but no open-iscsi installation was detected on this system."/>

                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource SteamText}"
                           Text="Install open-iscsi with your distribution's package manager:"/>

                <Border Padding="12"
                        Background="{DynamicResource SteamCard}"
                        BorderBrush="{DynamicResource SteamBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{DynamicResource SteamText}" Text="Debian / Ubuntu / Linux Mint:"/>
                        <SelectableTextBlock Foreground="{DynamicResource SteamText}" FontFamily="monospace"
                                             Text="sudo apt install open-iscsi"/>
                        <TextBlock Foreground="{DynamicResource SteamText}" Text="Fedora / RHEL / CentOS:"/>
                        <SelectableTextBlock Foreground="{DynamicResource SteamText}" FontFamily="monospace"
                                             Text="sudo dnf install iscsi-initiator-utils"/>
                        <TextBlock Foreground="{DynamicResource SteamText}" Text="Arch / Manjaro / CachyOS:"/>
                        <SelectableTextBlock Foreground="{DynamicResource SteamText}" FontFamily="monospace"
                                             Text="sudo pacman -S open-iscsi"/>
                        <TextBlock Foreground="{DynamicResource SteamText}" Text="openSUSE:"/>
                        <SelectableTextBlock Foreground="{DynamicResource SteamText}" FontFamily="monospace"
                                             Text="sudo zypper install open-iscsi"/>
                    </StackPanel>
                </Border>

                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource SteamText}"
                           Text="After installing, make sure the iscsid service is running:"/>

                <SelectableTextBlock Foreground="{DynamicResource SteamText}" FontFamily="monospace"
                                     Text="sudo systemctl enable --now iscsid"/>

                <TextBlock x:Name="SudoNotice"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           Foreground="{DynamicResource SteamText}"
                           Text="Note: iSCSI-Util also needs sudo to run iscsiadm. Install sudo or run the application as root."/>

                <Button Content="Close"
                        Width="100"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource SteamAccent}"
                        Foreground="White"
                        Click="OnClose"/>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
