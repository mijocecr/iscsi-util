<UserControl
    x:Class="ISCSI_Util.Views.TargetsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Styles>

        <!-- Tarjetas elevadas Steam -->
        <Style Selector="Border.SteamCard">
            <Setter Property="Background" Value="{DynamicResource SteamCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamBorderStrong}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12,16,6" />
            <Setter Property="BoxShadow" Value="0 4 12 #80000000" />
        </Style>

        <!-- Botones Steam -->
        <Style Selector="Button.SteamButton">
            <Setter Property="Background" Value="{DynamicResource SteamCard}" />
            <Setter Property="Foreground" Value="{DynamicResource SteamText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamBorder}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.SteamButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SteamAccentHover}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamAccent}" />
        </Style>

        <Style Selector="Button.SteamButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SteamAccentPressed}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamAccent}" />
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- DISCOVER -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">

            <TextBox x:Name="PortalBox"
                     Width="260"
                     TextAlignment="Center"
                     
                     HorizontalAlignment="Center"
                     Watermark="Portal (e.g. 192.168.1.10)" 
                     KeyUp="PortalBox_KeyUp"
                     />

            <Button Classes="SteamButton"
                    x:Name="DiscoverButton"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Right"
                    Content="Discover"
                    Click="DiscoverButton_Click" />
        </StackPanel>

        <!-- TARGET LIST -->
        <Border Grid.Row="1"
                Classes="SteamCard"
                MinHeight="100"
                Margin="0,12,0,5">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TargetsList"
                            Spacing="10" />
            </ScrollViewer>
        </Border>

        <!-- DETAILS PANEL (compactado y alineado) -->
        <Border Grid.Row="2"
                Classes="SteamCard"
                Margin="0,10,0,0"
                MaxHeight="250"
                CornerRadius="10">

            <!-- Fondo con degradado Steam -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#102A475E" Offset="0"/>
                    <GradientStop Color="#081B2838" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel Spacing="4">

                <!-- HEADER -->
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Target Details"
                               FontSize="15"
                               TextAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamBlue}" />
                    <Rectangle Height="1"
                               Fill="#40FFFFFF"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- CONTENIDO -->
                <Grid ColumnDefinitions="230,Auto"
                      ColumnSpacing="10">

                    <!-- INFO -->
                    <StackPanel x:Name="DetailsInfoPanel"
                                Spacing="3"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />

                    <!-- ICON -->
                    <Image x:Name="DetailsIcon"
                           Grid.Column="1"
                           Width="200"
                           Height="200"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="10,18,10,0"
                           IsHitTestVisible="False" />

                </Grid>


            </StackPanel>

        </Border>

    </Grid>
</UserControl>
