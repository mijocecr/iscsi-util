<UserControl
    x:Class="ISCSI_Util.Views.TargetsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Styles>
        
        <!-- Tarjeta estilo Sessions -->
        <Style Selector="Border.SteamCard">
            <Setter Property="Background" Value="#1B2838" />
            <Setter Property="BorderBrush" Value="#66C0F4" />
            <Setter Property="BorderThickness" Value="1.6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BoxShadow" Value="0 6 14 #80000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Hover estilo Sessions -->
        <Style Selector="Border.SteamCard:pointerover">
            <Setter Property="Background" Value="#1C2632" />
            <Setter Property="BorderBrush" Value="#3A4F63" />
            <Setter Property="BoxShadow" Value="0 0 18 #552A9FFF" />
        </Style>

        <!-- Seleccionado estilo Sessions -->
        <Style Selector="Border.SteamCard:selected">
            <Setter Property="Background" Value="#1E2F45" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamBlue}" />
            <Setter Property="BorderThickness" Value="2.4" />
            <Setter Property="BoxShadow" Value="0 0 22 #AA1E90FF" />
        </Style>

        <!-- Botones Steam -->
        <Style Selector="Button.SteamButton">
            <Setter Property="Background" Value="{DynamicResource SteamCard}" />
            <Setter Property="Foreground" Value="{DynamicResource SteamText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamBorder}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.SteamButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SteamAccentHover}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamAccent}" />
        </Style>

        <Style Selector="Button.SteamButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SteamAccentPressed}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamAccent}" />
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- DISCOVER -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">

            <TextBox x:Name="PortalBox"
                     Width="260"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     Watermark="Portal (e.g. 192.168.1.10)" 
                     KeyUp="PortalBox_KeyUp"/>

            <Button Classes="SteamButton"
                    x:Name="DiscoverButton"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Right"
                    Content="Discover"
                    Click="DiscoverButton_Click" />
        </StackPanel>

        <!-- TARGET LIST -->
        <Border Grid.Row="1"
                Cursor="Hand"
                Classes="SteamCard"
                MinHeight="120"
                Margin="0,12,0,5">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TargetsList"
                            Spacing="10" />
            </ScrollViewer>
        </Border>

        <!-- DETAILS PANEL -->
        <Border Grid.Row="2"
                x:Name="DetailsCard"
                Classes="SteamCard"
                Margin="0,5,0,0"
                MaxHeight="300"
                CornerRadius="10"
                IsVisible="False">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#102A475E" Offset="0"/>
                    <GradientStop Color="#081B2838" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel Spacing="1">

                <!-- TARGET TITLE -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,0,0,0"
                      x:Name="HeaderRow"
                      IsVisible="False">

                    <TextBlock x:Name="TargetDetailsTitle"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SteamGreen}"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>

                    <Button x:Name="BtnDeleteNode"
                            Grid.Column="1"
                            Content="Delete Node"
                            ToolTip.Tip="Remove the local iSCSI node configuration. Does not affect data"
                            Classes="SteamButton"
                            Width="140"
                            IsVisible="False"
                            Background="DarkRed"
                            Foreground="White"/>
                </Grid>

                <!-- LUN SELECTOR -->
                <Grid x:Name="LunSelectorRow"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="8"
                      Margin="0,2,0,2"
                      IsVisible="False">
                    <TextBlock Text="LUN:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SteamBlue}"/>

                    <ComboBox x:Name="LunSelector"
                              Grid.Column="1"
                              Width="220"
                              HorizontalAlignment="Left"
                              ToolTip.Tip="Select the LUN to manage. Connect, mount, initialize and persistence apply to this LUN."/>
                </Grid>

                <!-- TARGET ACTIONS -->
                <Grid x:Name="HeaderActionsRow"
                      ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                      ColumnSpacing="1"
                      IsVisible="False">
                    <Button x:Name="BtnHeaderUnmount"
                            Grid.Column="0"
                            Content="Unmount"
                            Classes="SteamButton"
                            Width="104"
                            IsVisible="False"/>

                    <Button x:Name="BtnHeaderOpen"
                            Grid.Column="1"
                            Content="Open"
                            Classes="SteamButton"
                            Width="104"
                            IsVisible="False"/>

                    <Button x:Name="BtnInitializeLun"
                            Grid.Column="2"
                            Content="Initialize LUN"
                            ToolTip.Tip="Format and mount the selected LUN. This destroys existing data on it."
                            Classes="SteamButton"
                            Width="104"
                            IsVisible="False"/>

                    <Button x:Name="BtnTogglePersist"
                            Grid.Column="4"
                            Content="Persist"
                            Classes="SteamButton"
                            Width="104"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Grid>


                <Rectangle Height="1"
                           Fill="#40FFFFFF"
                           Margin="0,1,0,1"/>

                <!-- CONTENIDO DETALLES -->
                <Grid ColumnDefinitions="*,140"
                      ColumnSpacing="6"
                      Margin="0,0,0,0"
                      VerticalAlignment="Top">

                    <StackPanel x:Name="DetailsInfoPanel"
                                Spacing="4"
                                Margin="0,4,4,0"
                                VerticalAlignment="Top" />

                    <Border Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Padding="3"
                            Margin="0"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource SteamBorderStrong}"
                            BorderThickness="3"
                            Background="White"
                            ClipToBounds="True">
                        <Image x:Name="DetailsIcon"
                               Width="130"
                               Height="130"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0"
                               IsHitTestVisible="False"/>
                    </Border>

                </Grid>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
