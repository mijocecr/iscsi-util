<UserControl
    x:Class="ISCSI_Util.Views.TargetsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Styles>
        
        <!-- Tarjeta estilo Sessions -->
        <Style Selector="Border.SteamCard">
            <Setter Property="Background" Value="#1B2838" />
            <Setter Property="BorderBrush" Value="#66C0F4" />
            <Setter Property="BorderThickness" Value="1.6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BoxShadow" Value="0 6 14 #80000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Hover estilo Sessions -->
        <Style Selector="Border.SteamCard:pointerover">
            <Setter Property="Background" Value="#1C2632" />
            <Setter Property="BorderBrush" Value="#3A4F63" />
            <Setter Property="BoxShadow" Value="0 0 18 #552A9FFF" />
        </Style>

        <!-- Seleccionado estilo Sessions -->
        <Style Selector="Border.SteamCard:selected">
            <Setter Property="Background" Value="#1E2F45" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamBlue}" />
            <Setter Property="BorderThickness" Value="2.4" />
            <Setter Property="BoxShadow" Value="0 0 22 #AA1E90FF" />
        </Style>

        <!-- Botones Steam -->
        <Style Selector="Button.SteamButton">
            <Setter Property="Background" Value="{DynamicResource SteamCard}" />
            <Setter Property="Foreground" Value="{DynamicResource SteamText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamBorder}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.SteamButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SteamAccentHover}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamAccent}" />
        </Style>

        <Style Selector="Button.SteamButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SteamAccentPressed}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamAccent}" />
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="12">

        <!-- DISCOVER -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">

            <TextBox x:Name="PortalBox"
                     Width="260"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     Watermark="Portal (e.g. 192.168.1.10)" 
                     KeyUp="PortalBox_KeyUp"/>

            <Button Classes="SteamButton"
                    x:Name="DiscoverButton"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Right"
                    Content="Discover"
                    Click="DiscoverButton_Click" />
        </StackPanel>

        <!-- CONTENIDO PRINCIPAL (2 Columnas) -->
        <Grid Grid.Row="1" ColumnDefinitions="1*,1.5*" ColumnSpacing="12">

            <!-- COLUMNA IZQUIERDA: Lista de targets -->
            <Border Grid.Column="0"
                    Cursor="Hand"
                    Background="{DynamicResource SteamPanel}"
                    BorderBrush="{DynamicResource SteamBorder}"
                    BorderThickness="1.2"
                    CornerRadius="12"
                    Padding="8">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TargetsList"
                                Spacing="8"
                                HorizontalAlignment="Stretch" />
                </ScrollViewer>
            </Border>

            <!-- COLUMNA DERECHA: Detalles del LUN seleccionado -->
            <Border Grid.Column="1"
                    x:Name="DetailsCard"
                    Classes="SteamCard"
                    BorderBrush="{DynamicResource SteamBorder}"
                    BorderThickness="1.2"
                    CornerRadius="10"
                    IsVisible="False">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#102A475E" Offset="0"/>
                        <GradientStop Color="#081B2838" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="6">

                        <!-- CABECERA: título, borrar nodo e icono -->
                        <Grid x:Name="HeaderRow"
                              ColumnDefinitions="*,64"
                              ColumnSpacing="8"
                              IsVisible="False">

                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="TargetDetailsTitle"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SteamGreen}"/>

                                <Button x:Name="BtnDeleteNode"
                                        Content="Delete Node"
                                        ToolTip.Tip="Remove the local iSCSI node configuration. Does not affect data"
                                        Classes="SteamButton"
                                        Width="100"
                                        HorizontalAlignment="Left"
                                        IsVisible="False"
                                        Background="DarkRed"
                                        Foreground="White"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="64"
                                    Height="64"
                                    Padding="2"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource SteamBorderStrong}"
                                    BorderThickness="2"
                                    Background="White"
                                    ClipToBounds="True">
                                <Image x:Name="DetailsIcon"
                                       Width="58"
                                       Height="58"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            </Border>
                        </Grid>

                        <!-- SELECTOR DE LUN -->
                        <Grid x:Name="LunSelectorRow"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="6"
                              IsVisible="False">
                            <TextBlock Text="LUN:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SteamBlue}"/>

                            <ComboBox x:Name="LunSelector"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Select the LUN to manage. Connect, mount, initialize and persistence apply to this LUN."/>
                        </Grid>

                        <!-- ACCIONES DEL LUN -->
                        <WrapPanel x:Name="HeaderActionsRow"
                                   Orientation="Horizontal"
                                   IsVisible="False">
                            <Button x:Name="BtnHeaderUnmount"
                                    Content="Unmount"
                                    Classes="SteamButton"
                                    Width="104"
                                    Margin="0,0,6,6"
                                    IsVisible="False"/>

                            <Button x:Name="BtnHeaderOpen"
                                    Content="Open"
                                    Classes="SteamButton"
                                    Width="104"
                                    Margin="0,0,6,6"
                                    IsVisible="False"/>

                            <Button x:Name="BtnInitializeLun"
                                    Content="Initialize LUN"
                                    ToolTip.Tip="Format and mount the selected LUN. This destroys existing data on it."
                                    Classes="SteamButton"
                                    Width="104"
                                    Margin="0,0,6,6"
                                    IsVisible="False"/>

                            <Button x:Name="BtnTogglePersist"
                                    Content="Persist"
                                    Classes="SteamButton"
                                    Width="104"
                                    Margin="0,0,6,6"/>
                        </WrapPanel>

                        <Rectangle Height="1"
                                   Fill="#40FFFFFF"
                                   Margin="0,1,0,1"/>

                        <!-- INFORMACIÓN DEL LUN -->
                        <StackPanel x:Name="DetailsInfoPanel"
                                    Spacing="4"
                                    VerticalAlignment="Top" />

                    </StackPanel>
                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>
