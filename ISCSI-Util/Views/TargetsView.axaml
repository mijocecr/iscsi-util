<UserControl
    x:Class="ISCSI_Util.Views.TargetsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- DISCOVER -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="10">

            <TextBox x:Name="PortalBox"
                     Width="260"
                     Watermark="Portal (e.g. 10.0.0.10)" />

            <Button x:Name="DiscoverButton"
                    Content="Discover"
                    Click="DiscoverButton_Click" />
        </StackPanel>

        <!-- TARGET LIST -->
        <Border Grid.Row="1"
                Margin="0,12,0,12"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TargetsList"
                            Spacing="10" />
            </ScrollViewer>
        </Border>

        <!-- DETAILS PANEL -->
        <Border Grid.Row="2"
                Padding="16"
                CornerRadius="8"
                Margin="0,10,0,0">

            <Grid ColumnDefinitions="*,Auto">

                <!-- INFO -->
                <StackPanel x:Name="DetailsInfoPanel"
                            Spacing="10"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center" />

                <!-- ICONO MÁS GRANDE -->
                <Image x:Name="DetailsIcon"
                       Grid.Column="1"
                       Width="160"
                       Height="160"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="10"
                       IsHitTestVisible="False" />

            </Grid>

        </Border>

    </Grid>
</UserControl>