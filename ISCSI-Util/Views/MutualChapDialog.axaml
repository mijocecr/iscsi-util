<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ISCSI_Util.Views.MutualChapDialog"
        Width="420"
        Height="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Configure Mutual CHAP">

    <StackPanel Margin="20" Spacing="14">

        <TextBlock Text="Mutual CHAP Authentication"
                   FontSize="20"
                   FontWeight="Bold"/>

        <!-- Normal CHAP -->
        <TextBlock Text="Username:"/>
        <TextBox x:Name="UserBox"
                 Width="260"
                 Watermark="CHAP username"/>

        <TextBlock Text="Password:"/>
        <TextBox x:Name="PassBox"
                 Width="260"
                 Watermark="CHAP password"
                 PasswordChar="●"/>

        <!-- Reverse CHAP -->
        <TextBlock Text="Reverse Username:"/>
        <TextBox x:Name="UserInBox"
                 Width="260"
                 Watermark="Mutual CHAP username"/>

        <TextBlock Text="Reverse Password:"/>
        <TextBox x:Name="PassInBox"
                 Width="260"
                 Watermark="Mutual CHAP password"
                 PasswordChar="●"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

            <Button x:Name="ApplyBtn"
                    Content="Apply"
                    Width="100"/>

            <Button x:Name="CancelBtn"
                    Content="Cancel"
                    Width="100"/>
        </StackPanel>

    </StackPanel>
</Window>