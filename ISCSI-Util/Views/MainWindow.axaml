<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ISCSI_Util.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ISCSI_Util.Models"
        mc:Ignorable="d"
        d:DesignWidth="500"
        d:DesignHeight="580"
        x:Class="ISCSI_Util.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.png"
        Title="ISCSI_Util"
        Background="{DynamicResource AppBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- GRID PRINCIPAL -->
    <Grid Background="{DynamicResource AppBackgroundBrush}"
          RowDefinitions="Auto,*,Auto">

        <!-- ===================================================== -->
        <!--                CONTENIDO SUPERIOR (RESPONSIVO)        -->
        <!-- ===================================================== -->
        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto,Auto,*,Auto"
              Background="{DynamicResource AppBackgroundBrush}">

            <!-- PANEL SUPERIOR -->
            <Panel Grid.Row="0"
                   HorizontalAlignment="Stretch"
                   Background="{DynamicResource AppForegroundBrush}"
                   Height="60">

                <TextBlock Text="Conectar  iSCSI"
                           FontWeight="Bold"
                           FontSize="28"
                           Foreground="{DynamicResource AppBackgroundBrush}"
                           Height="60"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Padding="0 10 0 0"
                           Margin="0 10 0 0"/>
            </Panel>

            <!-- LABEL DIRECCION IP -->
            <Grid Grid.Row="1"
                  RowDefinitions="*" ColumnDefinitions="*,*">
                <TextBlock Grid.Column="0"
                           Text="Direccion IP:"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppForegroundBrush}"
                           FontWeight="Bold"
                           FontSize="20"
                           Padding="10,0,0,0"
                           Margin="0 10 0 10"/>
            </Grid>

            <!-- INPUT IP + BOTON DESCUBRIR -->
            <Grid Grid.Row="2"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto">

                <TextBox Grid.Column="0"
                         HorizontalAlignment="Stretch"
                         TextAlignment="Center"
                         FontSize="15"
                         FontWeight="Bold"
                         Margin="5 0 5 10"
                         Grid.ColumnSpan="3"
                         Text="{Binding IpServidor, Mode=TwoWay}"
                         Background="{DynamicResource AppBackgroundBrush}"
                         Foreground="{DynamicResource AppForegroundBrush}"/>

                <TextBlock Grid.Column="0"
                           Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="[ Unidades Disponibles ]"
                           FontWeight="Bold"
                           FontSize="15"
                           Grid.ColumnSpan="2"
                           Foreground="YellowGreen"
                           Margin="5 5 5 0"/>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Width="150"
                        Height="45"
                        Content="Descubrir Destinos"
                        VerticalContentAlignment="Center"
                        Foreground="Black"
                        Background="Yellow"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="5 5 5 0"
                        Command="{Binding DescubrirDestinosCommand}"/>
            </Grid>

            <!-- LISTA DE DESTINOS (RESPONSIVA) -->
            <ListBox Grid.Row="3"
                     Background="{DynamicResource AppBackgroundBrush}"
                     Margin="5 10 5 10"
                     ItemsSource="{Binding Destinos}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:IscsiDestino">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                              RowDefinitions="Auto,Auto"
                              Margin="5">

                            <CheckBox Grid.RowSpan="2"
                                      Grid.Column="0"
                                      ToolTip.Tip="Marca esta casilla para seleccionar el destino"
                                      IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="5"
                                      Foreground="{DynamicResource AppForegroundBrush}"/>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Iqn}"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           FontWeight="Bold"
                                           Margin="5,0,0,0"/>
                            </StackPanel>

                            <Button Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    Content="Inicializar"
                                    IsVisible="{Binding PuedeInicializar}"
                                    Command="{Binding $parent[Window].DataContext.InicializarDestinoCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Orange"
                                    Foreground="Black"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Margin="2,5,20,5"
                                    Padding="10,5"/>

                            <Path Grid.RowSpan="2"
                                  Grid.Row="0"
                                  Grid.Column="3"
                                  Width="14"
                                  Height="14"
                                  Data="{Binding Conectado, Converter={StaticResource EstadoToGeometryConverter}}"
                                  Fill="{Binding Conectado, Converter={StaticResource BoolToColorConverter}}"
                                  Stroke="DarkGray"
                                  StrokeThickness="{Binding Conectado, Converter={StaticResource BoolToStrokeConverter}}"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Spacing="15"
                                        Margin="5,2,0,0">

                                <ToggleSwitch IsChecked="{Binding UsaChap, Mode=TwoWay}"
                                              Content="CHAP"
                                              Width="90"
                                              Foreground="LightCoral"
                                              Margin="10 0 10 0"/>

                                <ToggleSwitch Content="Persistir"
                                              Width="90"
                                              ToolTip.Tip="Mantener este destino conectado cuando reinicie sistema"
                                              Foreground="DeepSkyBlue"
                                              IsChecked="{Binding Persistir, Mode=TwoWay}"
                                              Margin="10 2 10 0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- PANEL CHAP (Auto) -->
            <StackPanel Grid.Row="4"
                        Margin="0 10 0 0"
                        IsVisible="{Binding HayChapActivo}">

                <Grid RowSpacing="5"
                      RowDefinitions="*,*"
                      ColumnDefinitions="Auto,*,*">

                    <TextBlock Grid.Column="0"
                               Grid.Row="0"
                               Text="Usuario:"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Padding="50, 0 5 0"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <TextBlock Grid.Column="0"
                               Grid.Row="1"
                               Text="Password:"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Padding="50, 0 5 0"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               FontWeight="Bold"
                               FontSize="15"/>

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Height="30"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"
                             Grid.ColumnSpan="2"
                             
                             Text="{Binding Usuario, Mode=TwoWay}"
                             Margin="0 0 5 0"
                             Background="{DynamicResource AppBackgroundBrush}"
                             Foreground="{DynamicResource AppForegroundBrush}"/>

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Height="30"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"
                             Grid.ColumnSpan="2"
                             
                             PasswordChar="*"
                             Text="{Binding Password, Mode=TwoWay}"
                             Margin="0 0 5 0"
                             Background="{DynamicResource AppBackgroundBrush}"
                             Foreground="{DynamicResource AppForegroundBrush}"/>
                </Grid>
            </StackPanel>

        </Grid>

        <!-- ===================================================== -->
        <!--                        FOOTER                         -->
        <!-- ===================================================== -->
        <Grid Grid.Row="2"
              RowDefinitions="*"
              ColumnDefinitions="*,Auto,Auto"
              Background="{DynamicResource AppBackgroundBrush}">

            <Image Grid.Column="0"
                   Height="45"
                   Width="100"
                   Margin="10 15 10 10"
                   Source="../Assets/Linux-Logo.png"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom">
                <ToolTip.Tip>https://github.com/mijocecr</ToolTip.Tip>
            </Image>


            <TextBlock Grid.Column="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Foreground="{DynamicResource AppForegroundBrush}"
                       FontWeight="DemiBold"
                       FontSize="25"
                       
                       Height="45"
                       Padding="0 0 0 5"
                       Text="Cerratonix"/>
            

            <Button Grid.Column="1"
                    Height="45"
                    Content="Desconectar"
                    Command="{Binding DesconectarSeleccionadosCommand}"
                    Background="Red"
                    Foreground="White"
                    FontWeight="Bold"
                    VerticalAlignment="Bottom"
                    VerticalContentAlignment="Center"
                    Margin="0 0 10 10"/>

            <Button Grid.Column="2"
                    Height="45"
                    Content="Conectar"
                    Command="{Binding ConectarSeleccionadosCommand}"
                    Background="#00aaa7"
                    Foreground="White"
                    FontWeight="Bold"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0 0 10 10"/>
        </Grid>

    </Grid>
</Window>
