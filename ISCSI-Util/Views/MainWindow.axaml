<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:ISCSI_Util.Views"
    x:Class="ISCSI_Util.Views.MainWindow"
    Width="500"
    Height="580"
    MinWidth="500"
    MinHeight="580"
    MaxWidth="500"
    MaxHeight="580"
    CanResize="False"
    Title="iscsi-util">

    <DockPanel>

        
        <Border Background="{DynamicResource SteamPanel}" Padding="10" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">

                <TextBlock 
                    Grid.Row="0" 
                    Grid.Column="0"
                    Text="iSCSI Management"
                    TextAlignment="Center"
                    FontSize="26"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                />

                <Button Content="⚙"
                        Grid.Column="1"
                        Grid.Row="0"
                        Margin="10"
                        FontSize="18"
                        Click="OnOpenConfig"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Classes="SteamButton"/>
            </Grid>
        </Border>

        <!-- BOTTOM STATUS BAR -->
        <Border Background="{DynamicResource SteamPanel}" Padding="6" DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusBarText"
                       Text="Ready."
                       TextAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource SteamText}"
                       PointerPressed="OnTabStatusBarClick"
                       Opacity="0.85"/>
        </Border>

        <!-- MAIN CONTENT -->
        <TabControl x:Name="MainTabs">

            <!-- STATUS TAB -->
            <TabItem PointerPressed="OnTabStatusClick">
                <TabItem.Header>
                    <TextBlock Text="Status" Tag="0"/>
                </TabItem.Header>

                <views:StatusView x:Name="StatusPanel"/>
            </TabItem>

            <!-- TARGETS TAB -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Targets" Tag="1"
                               PointerPressed="OnTabTargetClick"/>
                </TabItem.Header>

                <views:TargetsView x:Name="TargetsView"/>
            </TabItem>

            <!-- SESSIONS TAB -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Sessions" Tag="2"
                               PointerPressed="OnTabSessionsClick"/>
                </TabItem.Header>

                <views:SessionsView x:Name="SessionsPanel"/>
            </TabItem>

            <!-- LOGS TAB -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Logs" Tag="3"
                               PointerPressed="onTabLogsClick"/>
                </TabItem.Header>

                <views:LogsView x:Name="LogsView"/>
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>
